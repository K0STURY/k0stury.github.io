---
// How I make art: the writing lives in src/content/pages/process.md
import { getEntry } from "astro:content";
import BaseLayout from "@layouts/base-layout.astro";
import Lightbox from "@components/lightbox.svelte";
import getAllArt, { type Artwork } from "@api/art";
import { getLightboxImages } from "src/helpers/lightbox-images";
import "@styles/prose.css";

const entry = await getEntry("pages", "process");
if (!entry) throw new Error("src/content/pages/process.md is missing");
const { Content } = await entry.render();
const { title, description } = entry.data;

// The pieces the writing links to (/art/<id>) open in a lightbox right here, browsable
// in the order they appear, instead of leaving the page. A redraw brings its original
// along (after the rest), so its then & now works here too.
const linkedIds = [...new Set([...entry.body.matchAll(/\]\(\/art\/(\d+)\)/g)].map((m) => Number(m[1])))];
const arts = await Astro.glob<Artwork>("../assets/showcase/*.png").then((data) => getAllArt(data));
const byId = new Map(arts.map((art) => [art.id, art]));
const linked = linkedIds.flatMap((id) => byId.get(id) ?? []);
const originals = linked.flatMap((art) =>
  art.redrawOf != null && !linkedIds.includes(art.redrawOf) ? (byId.get(art.redrawOf) ?? []) : [],
);
const images = await getLightboxImages([...linked, ...new Set(originals)]);
---

<BaseLayout page={{ title: `${title} · Kostur`, description, path: "process" }} tagline="back to carving shapes…">
  <article class="process">
    <a href="/" class="process-back" data-astro-prefetch>The gallery</a>

    <header class="process-head">
      <h1 class="process-title">{title}</h1>
      <p class="process-lede">{description}</p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <a href="/#gallery-scene" class="process-end" data-astro-prefetch>See the stash</a>
  </article>

  {images.length > 0 && <Lightbox images={images} client:idle />}
</BaseLayout>

<script>
  // A click on a piece opens it in the lightbox, flying out of its sticker, instead of
  // leaving for its own page. Ctrl/cmd/middle-click still open the page in a new tab.
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLAnchorElement>('.process .prose a[href^="/art/"]').forEach((link) => {
      if (!link.querySelector("img")) return;
      link.addEventListener("click", (e) => {
        if (e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
        const id = Number(link.getAttribute("href")?.split("/").pop());
        if (!Number.isFinite(id)) return;
        e.preventDefault();
        document.dispatchEvent(new CustomEvent("lightbox:open", { detail: { id, filter: "all", source: link } }));
      });
    });
  });
</script>

<style>
  /* Wide enough for the art to sit beside the writing; plain text still keeps to a
     comfortable line length */
  .process {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 7.5rem 1.5rem 2rem;
  }

  .process .prose {
    max-width: none;
  }

  .process .prose > :global(:not(.art-section)) {
    max-width: 68ch;
  }

  /* Paper labels, like the nav's and the dev log's */
  .process-back,
  .process-end {
    display: inline-block;
    padding: 0.35rem 0.85rem 0.2rem;
    border-radius: 4px;
    background: var(--text-color);
    color: var(--primary-color);
    box-shadow: 3px 3px 0 var(--edge-color);
    font-family: var(--font-accent);
    letter-spacing: 0.02em;
    text-decoration: none;
    transform: rotate(-2deg);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .process-back::before {
    content: "‹ ";
  }

  .process-end {
    margin-top: 3.5rem;
    padding: 0.55rem 1.2rem 0.4rem;
    background: var(--accent-color);
    font-size: 1.2rem;
    transform: rotate(1.5deg);
  }

  .process-end::after {
    content: " ›";
  }

  .process-back:hover,
  .process-back:focus-visible,
  .process-end:hover,
  .process-end:focus-visible {
    transform: rotate(0deg) scale(1.06);
  }

  .process-back:focus-visible,
  .process-end:focus-visible {
    outline: 3px solid var(--accent-color);
    outline-offset: 3px;
  }

  /* The title on an accent sticky note, like the dev log's posts */
  .process-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    margin: 2.75rem 0 3rem;
  }

  .process-title {
    position: relative;
    max-width: 100%;
    padding: 0.9rem 1.4rem 1.05rem;
    border-radius: 6px;
    background: var(--accent-color);
    color: var(--primary-color);
    box-shadow: 5px 5px 0 var(--edge-color);
    font-family: var(--font-accent);
    font-size: clamp(2.1rem, 6vw, 3.25rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.01em;
    overflow-wrap: anywhere;
    transform: rotate(-1.5deg);
  }

  /* Tape */
  .process-title::before {
    content: "";
    position: absolute;
    top: -10px;
    left: 50%;
    width: 44px;
    height: 16px;
    border-radius: 2px;
    background: rgba(244, 240, 232, 0.35);
    transform: translateX(-50%) rotate(-4deg);
  }

  .process-lede {
    max-width: 60ch;
    color: rgba(244, 240, 232, 0.6);
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .process {
      padding: 6rem 1.1rem 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .process-back,
    .process-end {
      transition: none;
    }
  }
</style>
