---
import BaseLayout from "@layouts/base-layout.astro";
---

<BaseLayout>
  <section class="error-page">
    <div class="drop" style="--i:0;">
      <div class="blank-print">
        <!-- An empty print: the piece that should be here was never painted -->
        <div class="blank-canvas" id="error-canvas">
          <h1 class="error-title">4<span class="error-zero">0</span>4</h1>
        </div>
        <p class="blank-tag">
          <span class="tag-hole" aria-hidden="true"></span>this canvas is blank
        </p>
      </div>
    </div>

    <p class="error-desc drop" style="--i:1;">
      looks like this page doesn't exist — or maybe it was never painted.
    </p>

    <div class="drop" style="--i:2;">
      <a href="/" class="error-btn">back to the gallery &rarr;</a>
    </div>
  </section>
</BaseLayout>

<style>
  .error-page {
    --paper: var(--text-color);
    --ink: var(--primary-color);

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    min-height: 88vh;
    padding: 7rem 1.5rem 4rem;
    text-align: center;
  }

  /* Each piece drops onto the desk in turn; rotation lives on the inner elements */
  .drop {
    animation: error-drop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    animation-delay: calc(var(--i) * 120ms);
  }

  @keyframes error-drop {
    from { opacity: 0; transform: translateY(-22px) scale(0.92); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* Same print as the gallery's big view: paper frame, tape, hanging tag */
  .blank-print {
    position: relative;
    border: 10px solid var(--paper);
    border-radius: 6px;
    background: var(--paper);
    box-shadow: 10px 10px 0 var(--edge-color);
    transform: rotate(-2deg);
  }

  .blank-print::before {
    content: "";
    position: absolute;
    top: -23px;
    left: 50%;
    z-index: 2;
    width: 96px;
    height: 26px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--accent-color) 75%, transparent);
    transform: translateX(-50%) rotate(-3deg);
  }

  .blank-canvas {
    position: relative;
    display: grid;
    place-items: center;
    width: min(26rem, 78vw);
    aspect-ratio: 4 / 3;
    border-radius: 2px;
    background: var(--ink);
    overflow: hidden;
  }

  .error-title {
    position: relative;
    z-index: 1;
    font-family: var(--font-accent);
    font-size: clamp(5rem, 22vw, 9.5rem);
    line-height: 1;
    color: var(--paper);
  }

  .error-zero {
    display: inline-block;
    color: var(--accent-color);
    animation: wobble 2s ease-in-out infinite;
  }

  @keyframes wobble {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(-8deg); }
    75% { transform: rotate(8deg); }
  }

  .blank-tag {
    position: absolute;
    right: -2rem;
    bottom: -1.9rem;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 1rem 0.45rem 0.75rem;
    border-radius: 16px 5px 5px 16px;
    background: var(--accent-color);
    color: var(--ink);
    box-shadow: 4px 4px 0 var(--edge-color);
    font-family: var(--font-accent);
    font-size: 1.05rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
    transform: rotate(3deg);
  }

  .tag-hole {
    width: 10px;
    height: 10px;
    margin-bottom: 0.15rem;
    border-radius: 50%;
    background: var(--ink);
  }

  .error-desc {
    max-width: 34ch;
    margin-top: 1rem;
    font-size: 0.95rem;
    color: rgba(244, 240, 232, 0.6);
  }

  .error-btn {
    display: inline-block;
    padding: 0.6rem 1.4rem;
    border: 2px solid var(--accent-color);
    border-radius: 9999px;
    color: var(--text-color);
    font-family: var(--font-accent);
    font-size: 0.95rem;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .error-btn:hover {
    background: var(--accent-color);
    color: var(--primary-color);
    animation: gelatine 0.375s ease-in-out;
  }

  /* Paint splats on the empty canvas. :global — the script creates these, so they
     never carry Astro's scope attribute */
  .blank-canvas :global(.splatter) {
    position: absolute;
    border-radius: 50%;
    background: var(--accent-color);
    pointer-events: none;
    transform: translate(-50%, -50%);
    animation: splatter-fade 1.4s ease-out forwards;
  }

  @keyframes splatter-fade {
    0% { scale: 0; opacity: 0.5; }
    45% { scale: 1; opacity: 0.22; }
    100% { scale: 1.15; opacity: 0; }
  }

  @media (max-width: 480px) {
    .blank-print {
      border-width: 6px;
      box-shadow: 6px 6px 0 var(--edge-color);
    }

    .blank-print::before {
      top: -16px;
      width: 72px;
      height: 20px;
    }

    .blank-tag {
      right: -0.6rem;
      font-size: 0.95rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .drop,
    .error-zero {
      animation: none;
    }
  }
</style>

<script>
  let splatterTimer: ReturnType<typeof setInterval> | undefined;

  document.addEventListener("astro:page-load", () => {
    clearInterval(splatterTimer);

    const canvas = document.getElementById("error-canvas");
    if (!canvas) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    function spawnSplatter() {
      const dot = document.createElement("div");
      dot.className = "splatter";
      const size = 24 + Math.random() * 70;
      dot.style.width = `${size}px`;
      dot.style.height = `${size}px`;
      dot.style.left = `${Math.random() * 100}%`;
      dot.style.top = `${Math.random() * 100}%`;
      canvas!.appendChild(dot);
      dot.addEventListener("animationend", () => dot.remove(), { once: true });
    }

    for (let i = 0; i < 4; i++) setTimeout(spawnSplatter, 500 + i * 220);
    splatterTimer = setInterval(spawnSplatter, 900);
  });

  // Stop painting once the visitor leaves the page
  document.addEventListener("astro:before-swap", () => clearInterval(splatterTimer));
</script>
