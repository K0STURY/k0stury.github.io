---
// The dev log's posts (/blog/<post>), plus the front page again as blog/index.html.
// Nothing is built while the blog is switched off (blogLive in src/site.config.ts).
import BlogIndex from "@components/blog-index.astro";
import BlogPost from "@components/blog-post.astro";
import { blogEnabled, getPosts, type Post } from "src/helpers/blog";

export async function getStaticPaths() {
  if (!blogEnabled) return [];
  const posts = await getPosts(); // newest first
  return [
    ...posts.map((post, i) => ({
      params: { slug: post.slug },
      props: { post, newer: posts[i - 1], older: posts[i + 1] },
    })),
    // The front page (src/pages/[blog].astro builds it as blog.html) again, as blog/index.html.
    // The posts live in a blog/ folder, and with a blog.html beside it GitHub Pages could send
    // /blog to either one; having both means /blog works whichever it picks.
    { params: { slug: "index" }, props: { frontPage: true } },
  ];
}

const { frontPage, post, newer, older } = Astro.props as {
  frontPage?: boolean;
  post?: Post;
  newer?: Post;
  older?: Post;
};
---

{frontPage || !post ? <BlogIndex /> : <BlogPost post={post} newer={newer} older={older} />}
