---
// Meet Chibi Quil, the desk mascot: a bio, and a button for each animation. Every folder of
// frames in src/assets/mascot gets a button by itself; LABELS below just gives it a nicer name.
import BaseLayout from "@layouts/base-layout.astro";
import { getMascotAnimations, getMascotFrames } from "src/helpers/mascot";

const LABELS: Record<string, string> = {
  zzz: "Nap",
  pop_up: "Stir",
  click: "Wake up",
  idle: "Chill",
  like: "Get excited",
};
const RESTING = "zzz"; // what it starts on

const names = getMascotAnimations().sort((a, b) => Number(b === RESTING) - Number(a === RESTING));
const animations = await Promise.all(names.map(async (name) => ({ name, frames: await getMascotFrames(name) })));

const facts = [
  ["Name", "Chibi Quil"],
  ["Made by", "Kostur, it's my OC"],
  ["Job", "desk supervisor (unpaid)"],
  ["Hours", "asleep, mostly"],
  ["Likes", "your likes, naps, the warm spot on the monitor"],
  ["Dislikes", "fast scrolling. it's rude."],
  ["Favourite tool", "ctrl+z"],
];
---

<BaseLayout
  page={{
    title: "Meet Chibi Quil · Kostur",
    description: "Chibi Quil, the sleepy little supervisor of this desk. Press a button and see what happens.",
    path: "mascot",
  }}
  tagline="shh, it's sleeping."
>
  <article class="meet">
    <a href="/" class="meet-back" data-astro-prefetch>The gallery</a>

    <h1 class="meet-title">Meet Chibi Quil</h1>

    <div class="meet-desk">
      <div class="meet-left">
        <div class="meet-card" id="meet-card">
          {
            animations.flatMap(({ name, frames }) =>
              frames.map((f, i) => (
                <img
                  src={f.src}
                  alt={i === 0 && name === RESTING ? "Chibi Quil, a horned character in a hoodie" : ""}
                  data-anim={name}
                  data-ms={f.ms}
                  hidden={!(i === 0 && name === RESTING)}
                  draggable="false"
                />
              )),
            )
          }
        </div>

        <div class="meet-buttons" role="group" aria-label="Play an animation">
          {
            animations.map(({ name }) => (
              <button
                class="meet-btn"
                type="button"
                data-play={name}
                aria-pressed={name === RESTING ? "true" : "false"}
              >
                {LABELS[name] ?? name.replaceAll("_", " ")}
              </button>
            ))
          }
        </div>
      </div>

      <dl class="meet-note">
        {
          facts.map(([label, value]) => (
            <div class="meet-fact">
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </article>
</BaseLayout>

<script>
  let timer: ReturnType<typeof setTimeout>;

  document.addEventListener("astro:page-load", () => {
    clearTimeout(timer);
    const card = document.getElementById("meet-card");
    if (!card) return; // Not on this page

    // It's on the big card here, so the corner one takes the page off
    document.getElementById("mascot")?.classList.add("is-away");

    const images = [...card.querySelectorAll<HTMLImageElement>("img")];
    images.forEach((img) => img.decode().catch(() => {}));
    const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-play]")];
    const framesOf = (name: string) => images.filter((img) => img.dataset.anim === name);
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

    let shown = images.find((img) => !img.hidden) ?? images[0];
    const show = (frame: HTMLImageElement) => {
      shown.hidden = true;
      frame.hidden = false;
      shown = frame;
    };

    const play = (button: HTMLButtonElement) => {
      clearTimeout(timer);
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
      const frames = framesOf(button.dataset.play ?? "");
      if (still) return show(frames[0]);

      let at = 0;
      const step = () => {
        show(frames[at]);
        timer = setTimeout(step, Number(frames[at].dataset.ms));
        at = (at + 1) % frames.length;
      };
      step();
    };

    buttons.forEach((button) => button.addEventListener("click", () => play(button)));
    play(buttons[0]); // the nap
  });
</script>

<style>
  .meet {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    padding: 7.5rem 1.5rem 3rem;
  }

  .meet-back {
    display: inline-block;
    padding: 0.35rem 0.85rem 0.2rem;
    border-radius: 4px;
    background: var(--text-color);
    color: var(--primary-color);
    box-shadow: 3px 3px 0 var(--edge-color);
    font-family: var(--font-accent);
    letter-spacing: 0.02em;
    text-decoration: none;
    transform: rotate(-2deg);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .meet-back::before {
    content: "‹ ";
  }

  .meet-back:hover,
  .meet-back:focus-visible {
    transform: rotate(0deg) scale(1.06);
  }

  .meet-title {
    width: fit-content;
    margin: 2.5rem 0 3rem;
    padding: 0.9rem 1.4rem 0.8rem;
    border-radius: 6px;
    background: var(--accent-color);
    color: var(--primary-color);
    box-shadow: 5px 5px 0 var(--edge-color);
    font-family: var(--font-accent);
    font-size: clamp(2.1rem, 6vw, 3.25rem);
    font-weight: 400;
    line-height: 1;
    transform: rotate(-1.5deg);
  }

  .meet-desk {
    display: grid;
    grid-template-columns: minmax(0, 380px) minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
  }

  /* Same teal and border as the about section's avatar */
  .meet-card {
    display: grid;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border: 8px solid var(--text-color);
    border-radius: 2rem;
    background: #31c5d1;
    box-shadow: 8px 8px 0 var(--edge-color);
    transform: rotate(-3deg);
  }

  .meet-card img {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .meet-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.8rem;
  }

  .meet-btn {
    padding: 0.4rem 0.85rem 0.25rem;
    border: none;
    border-radius: 4px;
    background: var(--text-color);
    color: var(--primary-color);
    box-shadow: 3px 3px 0 var(--edge-color);
    font-family: var(--font-accent);
    letter-spacing: 0.02em;
    cursor: pointer;
    transform: rotate(-1.5deg);
    transition:
      transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
      background-color 0.2s ease;
  }

  .meet-btn:nth-child(even) {
    transform: rotate(1.5deg);
  }

  .meet-btn:hover,
  .meet-btn:focus-visible {
    transform: rotate(0deg) scale(1.08);
  }

  .meet-btn[aria-pressed="true"] {
    background: var(--accent-color);
  }

  .meet-back:focus-visible,
  .meet-btn:focus-visible {
    outline: 3px solid var(--accent-color);
    outline-offset: 3px;
  }

  .meet-note {
    position: relative;
    padding: 1.8rem 1.6rem 1.4rem;
    border-radius: 6px;
    background: var(--text-color);
    color: var(--primary-color);
    box-shadow: 6px 6px 0 var(--edge-color);
    transform: rotate(1deg);
  }

  .meet-note::before {
    content: "";
    position: absolute;
    top: -11px;
    left: 50%;
    width: 72px;
    height: 20px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--accent-color) 75%, transparent);
    transform: translateX(-50%) rotate(-3deg);
  }

  .meet-fact + .meet-fact {
    margin-top: 0.9rem;
  }

  .meet-fact dt {
    font-family: var(--font-accent);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    opacity: 0.6;
  }

  .meet-fact dd {
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.35;
  }

  @media (max-width: 760px) {
    .meet {
      padding: 6rem 1.25rem 2rem;
    }

    .meet-desk {
      grid-template-columns: minmax(0, 1fr);
    }

    .meet-left {
      max-width: 380px;
      margin: 0 auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .meet-back,
    .meet-btn {
      transition: none;
    }
  }
</style>
