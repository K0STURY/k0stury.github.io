---
import ThemeToggler from "./theme-toggler.svelte";
import { blogEnabled } from "src/helpers/blog";

const onBlog = Astro.url.pathname.startsWith("/blog");
---

<!-- Its own layer in page changes, held still while the page underneath turns over -->
<nav
  class="fixed items-center flex justify-between w-full z-50 group px-5 py-4 md:px-8"
  data-inview="false"
  transition:name="site-nav"
  transition:animate="none"
>
  <h1
    class="group-data-[inview='false']:text-3xl md:group-data-[inview='false']:text-4xl font-accent tracking-tighter transition-[font-size,transform] duration-300 ease-out hover:animate-gelatine-in-out"
  >
    <a href="/" class="text-color" id="nav-title" data-text="Kostur." data-astro-prefetch="load">Kos<span class="text-accent">tur.</span></a>
  </h1>
  <div class="nav-right">
    {
      blogEnabled && (
        <a
          href="/blog"
          class="nav-link"
          class:list={{ "is-current": onBlog }}
          aria-current={onBlog ? "page" : undefined}
          data-astro-prefetch
        >
          Dev log
        </a>
      )
    }
    <ThemeToggler client:load />
  </div>
</nav>

<script>
  function initNav() {
    // Intersection Observer setup — only on pages with #gallery
    const gallerySection = document.querySelector("#gallery");
    const navbar = document.querySelector("nav");

    if (gallerySection && navbar) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          navbar.setAttribute("data-inview", JSON.stringify(entry.isIntersecting));
        });
      }, { threshold: 0 });

      observer.observe(gallerySection);
    } else if (navbar) {
      // Other pages: transparent at the top, solid once scrolled, so it never sits
      // see-through over the text of a long post
      const update = () => navbar.setAttribute("data-inview", String(window.scrollY > 40));
      update();
      window.removeEventListener("scroll", (window as any).__navScroll);
      (window as any).__navScroll = update;
      window.addEventListener("scroll", update, { passive: true });
    }

    // Text scramble + glitch effect on nav title
    const navTitle = document.getElementById("nav-title");
    if (navTitle) {
      const finalText = navTitle.dataset.text ?? "Kostur.";
      const accentStart = 3;
      const chars = "!@#$%&*?/\\|<>{}[]~^";
      const duration = 800;
      const steps = 12;
      let step = 0;
      let titleEl: HTMLElement = navTitle;

      function scrambleStep() {
        if (step >= steps) {
          titleEl.innerHTML = `Kos<span class="text-accent">tur.</span>`;
          titleEl.classList.remove("glitching");
          return;
        }

        const progress = step / steps;
        let result = "";
        for (let i = 0; i < finalText.length; i++) {
          if (i / finalText.length < progress) {
            const ch = finalText[i];
            if (i >= accentStart) {
              result += `<span class="text-accent">${ch}</span>`;
            } else {
              result += ch;
            }
          } else {
            const ch = chars[Math.floor(Math.random() * chars.length)];
            if (i >= accentStart) {
              result += `<span class="text-accent">${ch}</span>`;
            } else {
              result += ch;
            }
          }
        }
        titleEl.innerHTML = result;
        step++;
        setTimeout(scrambleStep, duration / steps);
      }

      // Remove old listener before adding new one
      const newTitle = navTitle.cloneNode(true) as HTMLElement;
      navTitle.parentNode?.replaceChild(newTitle, navTitle);
      titleEl = newTitle;

      newTitle.addEventListener("mouseenter", () => {
        step = 0;
        titleEl.classList.add("glitching");
        scrambleStep();
      });

      // Initial scramble on page load
      step = 0;
      titleEl.classList.add("glitching");
      scrambleStep();
    }
  }

  document.addEventListener("astro:page-load", initNav);
</script>

<style>
  [data-inview="true"] {
    backdrop-filter: blur(28px);
    background-color: rgba(12, 11, 14, 0.72);
    border-bottom: 1px solid rgba(244, 240, 232, 0.06);
  }

  [data-inview="true"] > h1 {
    @apply text-3xl md:text-4xl transition-[font-size] duration-300 ease-out;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  /* A paper label, like the ones on the prints */
  .nav-link {
    padding: 0.35rem 0.85rem 0.2rem;
    border-radius: 4px;
    background: var(--text-color);
    color: var(--primary-color);
    box-shadow: 3px 3px 0 var(--edge-color);
    font-family: var(--font-accent);
    font-size: 1rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    white-space: nowrap;
    transform: rotate(-2deg);
    transition:
      transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
      background-color 0.2s ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    transform: rotate(0deg) scale(1.06);
  }

  .nav-link.is-current {
    background: var(--accent-color);
  }

  .nav-link:focus-visible {
    outline: 3px solid var(--accent-color);
    outline-offset: 3px;
  }

  @media (max-width: 480px) {
    .nav-right {
      gap: 0.8rem;
    }

    .nav-link {
      font-size: 0.9rem;
      padding: 0.3rem 0.65rem 0.15rem;
    }
  }

  /* Glitch effect on logo hover */
  #nav-title {
    position: relative;
    display: inline-block;
  }

  #nav-title.glitching {
    animation: glitch-jitter 0.1s steps(2) infinite;
  }

  @keyframes glitch-jitter {
    0% { transform: translate(0); }
    25% { transform: translate(-1px, 1px); }
    50% { transform: translate(1px, -1px); }
    75% { transform: translate(-1px, -1px); }
    100% { transform: translate(1px, 1px); }
  }
</style>
