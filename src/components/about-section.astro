---
import Avatar from "@assets/logo/avatar.png";
import { Image } from "astro:assets";
import { details, contacts, tools } from "src/site.config";
import ContactDetailCard from "./contact-detail-card.svelte";
import { Icon } from "astro-icon/components";
import { getMascotFrames } from "src/helpers/mascot";

const tagTilts = [-3, 2, -2, 3];
// The mascot's idle animation; the drawn portrait until there are frames
const avatarFrames = await getMascotFrames("idle");
---

<section class="about-desk" id="about">
  <div class="about-inner">
    <div class="drop" style="--i:0;">
      {
        avatarFrames.length ? (
          <div class="avatar-sticker avatar-sticker--frames" role="img" aria-label="Kostur's character">
            {avatarFrames.map((f, i) => (
              <img src={f.src} alt="" class="avatar-img avatar-frame" data-ms={f.ms} hidden={i > 0} draggable="false" />
            ))}
          </div>
        ) : (
          <div class="avatar-sticker">
            <Image src={Avatar} alt="Portrait of Kostur's character" format="webp" width={320} class="avatar-img" />
          </div>
        )
      }
    </div>

    <div class="about-side">
      <div class="drop" style="--i:1;">
        <div class="bio-note">
          <!-- Invisible full copy reserves the note's final size while the visible copy types in -->
          <p class="bio-ghost" aria-hidden="true"><Fragment set:html={details.aboutMe} /></p>
          <p class="bio-text" id="bio-text"><Fragment set:html={details.aboutMe} /></p>
          <a href="/process" class="bio-more" data-astro-prefetch>how I make art</a>
        </div>
      </div>

      <ul class="tag-row">
        {
          contacts.map((contact, i) => (
            <li class="drop" style={`--i:${2 + i}; --tilt:${tagTilts[i % tagTilts.length]}deg;`}>
              <ContactDetailCard contact={contact} client:idle>
                <Icon name={contact.icon} slot="icon" class="text-xl" />
              </ContactDetailCard>
            </li>
          ))
        }
      </ul>

      {
        tools.length > 0 && (
          <div class="drop" style={`--i:${2 + contacts.length};`}>
            <p class="tools-slip">
              <Icon name="mdi:draw" class="tools-icon" />
              <span class="tools-label">tools I use</span>
              {tools.map((tool) => (
                <span class="tool">{tool}</span>
              ))}
            </p>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .about-inner {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2.75rem;
    align-items: start;
    max-width: 860px;
    margin: 0 auto;
    padding: 4rem 1.5rem 2rem;
  }

  .about-side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    min-width: 0;
  }

  /* Drop-in: only armed by the script (.pre), so the section is fully visible without JS */
  .about-desk.pre .drop {
    opacity: 0;
  }

  .about-desk.is-in .drop {
    animation: about-drop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    animation-delay: calc(var(--i) * 90ms);
  }

  @keyframes about-drop {
    from { opacity: 0; transform: translateY(-22px) scale(0.9); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* Avatar: die-cut sticker */
  .avatar-sticker {
    width: 150px;
    height: 150px;
    border-radius: 1.9rem;
    border: 6px solid var(--text-color);
    background: var(--text-color);
    box-shadow: 7px 7px 0 var(--edge-color);
    overflow: hidden;
    transform: rotate(-5deg);
    transition:
      transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.25s ease;
  }

  .avatar-sticker:hover {
    transform: rotate(4deg) scale(1.06);
    box-shadow: 10px 10px 0 var(--accent-color);
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Animated: the frames stack in one cell on the old portrait's teal; only one isn't hidden */
  .avatar-sticker--frames {
    display: grid;
    background: #31c5d1;
  }

  /* A thin paper outline (like the desk mascot's) so the character reads on any background */
  .avatar-frame {
    grid-area: 1 / 1;
    filter: drop-shadow(1.5px 0 0 var(--text-color)) drop-shadow(-1.5px 0 0 var(--text-color))
      drop-shadow(0 1.5px 0 var(--text-color)) drop-shadow(0 -1.5px 0 var(--text-color));
  }

  .avatar-frame[hidden] {
    display: none;
  }

  /* Bio: sticky note with a strip of tape */
  .bio-note {
    position: relative;
    display: grid;
    max-width: 34rem;
    /* Room underneath for the "how I make art" label hanging off its corner */
    margin-bottom: 0.6rem;
    padding: 1.6rem 1.6rem 1.4rem;
    border-radius: 6px;
    background: var(--text-color);
    color: var(--primary-color);
    box-shadow: 6px 6px 0 var(--edge-color);
    transform: rotate(1deg);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .bio-note:hover {
    transform: rotate(-0.5deg) translateY(-3px);
  }

  .bio-note::before {
    content: "";
    position: absolute;
    top: -11px;
    left: 50%;
    width: 72px;
    height: 20px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--accent-color) 75%, transparent);
    transform: translateX(-50%) rotate(-3deg);
  }

  .bio-ghost,
  .bio-text {
    grid-area: 1 / 1;
    font-family: var(--font-accent);
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    letter-spacing: 0.02em;
    line-height: 1.5;
  }

  .bio-ghost {
    visibility: hidden;
  }

  /* :global — the typewriter rewrites this markup, so it never carries Astro's scope attribute */
  .bio-note :global(strong) {
    display: inline-block;
    padding: 0.05em 0.35em 0;
    border-radius: 4px;
    background: var(--accent-color);
    color: var(--primary-color);
    font-family: var(--font-accent);
    font-weight: 400;
    letter-spacing: 0.05em;
    transform: rotate(-2deg);
  }

  /* To the process page: an accent label stuck over the note's bottom-right corner */
  .bio-more {
    position: absolute;
    right: 1.2rem;
    bottom: -0.95rem;
    padding: 0.3rem 0.8rem 0.2rem;
    border-radius: 4px;
    background: var(--accent-color);
    color: var(--primary-color);
    box-shadow: 3px 3px 0 var(--edge-color);
    font-family: var(--font-accent);
    font-size: 0.95rem;
    letter-spacing: 0.03em;
    text-decoration: none;
    transform: rotate(-3deg);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .bio-more::after {
    content: " ›";
  }

  .bio-more:hover,
  .bio-more:focus-visible {
    transform: rotate(0deg) scale(1.08);
  }

  .bio-more:focus-visible {
    outline: 3px solid var(--text-color);
    outline-offset: 3px;
  }

  .bio-note :global(.bio-cursor) {
    animation: blink 0.7s infinite;
    font-weight: bold;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* Links: paper tags (the tag itself is styled in contact-detail-card.svelte) */
  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1.1rem;
    list-style: none;
  }

  /* Tools: a dashed cut-out slip */
  .tools-slip {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 0.9rem;
    border: 2px dashed rgba(244, 240, 232, 0.28);
    border-radius: 8px;
    transform: rotate(-1.5deg);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .tools-slip:hover {
    transform: rotate(0deg) translateY(-2px);
  }

  .tools-icon {
    width: 1.2rem;
    height: 1.2rem;
    color: var(--accent-color);
  }

  .tools-label {
    font-family: var(--font-accent);
    font-size: 0.95rem;
    letter-spacing: 0.03em;
    color: var(--text-color);
  }

  .tool {
    padding: 0.15rem 0.7rem;
    border-radius: 9999px;
    background: var(--accent-color);
    color: var(--primary-color);
    font-size: 0.8rem;
    font-weight: 700;
  }

  /* Mobile: stack and center */
  @media (max-width: 640px) {
    .about-inner {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 2rem;
      padding: 3rem 1.25rem 1.5rem;
    }

    .about-side {
      align-items: center;
    }

    .avatar-sticker {
      width: 132px;
      height: 132px;
    }

    .tag-row {
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-desk.is-in .drop {
      animation: none;
    }

    .bio-more {
      transition: none;
    }
  }
</style>

<script>
  let avatarTimer: ReturnType<typeof setTimeout>;

  document.addEventListener("astro:page-load", () => {
    // Avatar: loop the mascot's idle frames, each for its own time (idle/timing.json)
    clearTimeout(avatarTimer);
    const frames = [...document.querySelectorAll<HTMLImageElement>(".avatar-frame")];
    // Decode the hidden frames up front, so the first loop doesn't flash blank (see desk-mascot)
    frames.forEach((img) => img.decode().catch(() => {}));
    if (frames.length > 1 && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
      let at = 0;
      const next = () => {
        avatarTimer = setTimeout(() => {
          frames[at].hidden = true;
          at = (at + 1) % frames.length;
          frames[at].hidden = false;
          next();
        }, Number(frames[at].dataset.ms));
      };
      next();
    }

    const section = document.getElementById("about");
    const bioEl = document.getElementById("bio-text");
    if (!section || !bioEl) return;

    // Reduced motion: leave everything in place, fully visible, with the bio already written.
    // Same when coming back to the page during this visit (the hero remembers): it's been
    // written once already.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (document.getElementById("hero")?.classList.contains("is-returning")) return;

    const cursorHtml = '<span class="bio-cursor">|</span>';
    const fullHtml = bioEl.innerHTML.trim();
    bioEl.innerHTML = cursorHtml;
    section.classList.add("pre");

    let charIndex = 0;
    const speed = 35;

    function typeNext() {
      if (charIndex >= fullHtml.length) {
        setTimeout(() => bioEl!.querySelector(".bio-cursor")?.remove(), 800);
        return;
      }

      // Jump over whole tags so markup is never typed out half-open
      if (fullHtml[charIndex] === "<") {
        charIndex = fullHtml.indexOf(">", charIndex) + 1;
      } else {
        charIndex++;
      }

      bioEl!.innerHTML = fullHtml.substring(0, charIndex) + cursorHtml;

      const delay = fullHtml[charIndex - 1] === " " ? speed * 0.5 : speed;
      setTimeout(typeNext, delay);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries[0].isIntersecting) return;
        observer.disconnect();
        section.classList.add("is-in");
        setTimeout(typeNext, 450);
      },
      { threshold: 0.35 },
    );

    observer.observe(section);
  });
</script>
