---
import getAllArt, { type Artwork } from "@api/art";
import Avatar from "@assets/logo/avatar.png";
import { getImage } from "astro:assets";
import sortByDesc from "src/helpers/utils";

// Link previews (Discord, socials) show the newest highlighted piece
const arts = await Astro.glob<Artwork>("../assets/showcase/*.png").then((data) =>
  getAllArt(data),
);
const cover = arts.sort(sortByDesc).find((art) => art.tags.includes("Highlights"));

// PNG on purpose: not every service that builds previews reads WebP
const contentImg = await getImage({
  src: (cover?.default ?? Avatar) as any,
  width: 1200,
  format: "png",
});

const siteUrl = (Astro.site ?? Astro.url).href;
const ogImageUrl = new URL(contentImg.src, siteUrl).href;
const title = "Kostur's Art";
const description = "Character art and doodles that bite back. The art portfolio of Kostur.";
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="manifest" href="/site.webmanifest" />

<meta name="theme-color" content="#e7ae3a" />
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<meta name="language" content="English" />

<meta property="og:site_name" content={new URL(siteUrl).hostname} />
<meta property="og:title" content={title} />
<meta property="og:type" content="website" />
<meta property="og:url" content={siteUrl} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:alt" content={cover?.title ? `${cover.title}, by Kostur` : "Artwork by Kostur"} />
<meta property="og:description" content={description} />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={siteUrl} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImageUrl} />
